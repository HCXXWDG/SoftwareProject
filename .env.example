# Browser key for AMap JS API 2.0 (domain-restricted in production)
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_CODE=
VITE_API_BASE_URL=http://localhost:8080

# Server-side AMap Web Service key. Never expose this value in the frontend.
AMAP_WEB_KEY=
DEVICE_HASH_SALT=replace-with-a-long-random-secret
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,https://localhost
# 跨设备联调时追加局域网 IP，例如 http://192.168.1.10:5173
# 正式 PWA 域名通过此变量注入，禁止使用 *

# PostgreSQL/PostGIS profile
API_PORT=8080
SPRING_PROFILES_ACTIVE=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=commute_mood
POSTGRES_USER=commute
POSTGRES_PASSWORD=commute_dev_password
POSTGRES_PORT=5432

