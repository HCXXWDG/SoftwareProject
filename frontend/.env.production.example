# ── 生产环境配置 ──
# 复制此文件为 .env.production 并填入实际值

# 后端 HTTPS 地址（必须为 HTTPS，Android 9+ 禁止明文 HTTP）
VITE_API_BASE_URL=https://your-production-domain.com

# 高德 JS API Key（需在控制台配置以下限制）
#   - Web 端：限制域名
#   - Android 端：限制包名 + 签名 SHA1
# 获取 SHA1: keytool -list -v -keystore release.keystore -alias <keyAlias>
VITE_AMAP_JS_KEY=your-production-amap-key
VITE_AMAP_SECURITY_CODE=your-production-security-code
