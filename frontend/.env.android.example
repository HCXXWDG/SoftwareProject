# ── Android 环境配置 ──

# === 开发环境（模拟器） ===
# 模拟器中 10.0.2.2 映射到宿主机的 localhost
# 将此文件复制为 .env.android 并取消注释：
# VITE_API_BASE_URL=http://10.0.2.2:8080

# === 开发环境（真机局域网调试） ===
# 将 <你的局域网IP> 替换为电脑实际 IP（如 192.168.1.100）
# VITE_API_BASE_URL=http://<你的局域网IP>:8080

# === 生产环境 ===
# 部署后端到 HTTPS 服务器后，填入正式域名：
# VITE_API_BASE_URL=https://your-production-domain.com
