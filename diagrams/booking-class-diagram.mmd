classDiagram
    direction TB

    class User {
        &lt;&lt;abstract&gt;&gt;
        -String userId
        -String username
        -String password
        +login() boolean
        +logout() void
        +queryFlights(criteria) List~Flight~
    }

    class Guest {
        -String sessionId
        +queryFlights(criteria) List~Flight~
        +register() RegisteredUser
    }

    class RegisteredUser {
        -String email
        -String phone
        -List~Ticket~ ticketHistory
        -int monthlyCancelCount
        +purchaseTicket(Flight flight) Ticket
        +viewTickets() List~Ticket~
        +cancelTicket(Ticket ticket) boolean
        +checkPurchaseEligibility() boolean
        +getMonthlyCancelCount() int
    }

    class Administrator {
        -int adminLevel
        -String department
        +addFlight(Flight flight) boolean
        +removeFlight(String flightId) boolean
        +updateFlight(Flight flight) boolean
        +viewAllFlights() List~Flight~
    }

    class Flight {
        -String flightId
        -String flightNumber
        -String departure
        -String arrival
        -DateTime departureTime
        -DateTime arrivalTime
        -double price
        -int availableSeats
        +getFlightInfo() String
        +checkAvailability() boolean
        +bookSeat() boolean
        +releaseSeat() boolean
    }

    class Ticket {
        -String ticketId
        -DateTime purchaseDate
        -double price
        -TicketStatus status
        -String seatNumber
        +cancel() boolean
        +getDetails() String
        +isCancelled() boolean
        +getPurchaseDate() DateTime
        +getStatus() TicketStatus
    }

    class TicketStatus {
        &lt;&lt;enumeration&gt;&gt;
        VALID
        CANCELLED
        USED
    }

    class CreditSystem {
        &lt;&lt;boundary — 外部系统&gt;&gt;
        -int creditThreshold = 30
        -int penaltyPerCancel = 10
        -Map~String,int~ userCreditMap
        +getCreditLevel(String userId) int
        +lowerCreditLevel(String userId) void
        +isEligibleToPurchase(String userId) boolean
        +recordCancellation(String userId) void
        +getMonthlyCancelCount(String userId) int
    }

    class BookingSystem {
        &lt;&lt;facade&gt;&gt;
        -List~Flight~ flights
        -List~Ticket~ tickets
        +processCancellation(Ticket ticket) void
    }

    %% === 泛化关系 ===
    User <|-- Guest : 继承
    User <|-- RegisteredUser : 继承
    User <|-- Administrator : 继承

    %% === 聚合关系 ===
    RegisteredUser o-- "0..*" Ticket : 拥有
    BookingSystem o-- "0..*" Flight : 管理

    %% === 关联关系 ===
    Flight -- "1" Ticket : belongs to
    Administrator -- "0..*" Flight : manages
    Guest ..> "0..*" Flight : queries
    RegisteredUser ..> Flight : purchases

    %% === 依赖关系（外部系统交互）===
    RegisteredUser ..> CreditSystem : 检查信用/降低等级
    BookingSystem ..> CreditSystem : 退订时调用
